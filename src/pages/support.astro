---
/**
 * Support page — how to reach Glano.
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import { SITE } from '../config';

const email = SITE.supportEmail;
const site = Astro.site!.href.replace(/\/$/, '');

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ContactPage',
		name: 'Glano Support',
		url: `${site}/support`,
		mainEntity: {
			'@type': 'Organization',
			'@id': `${site}/#organization`,
			name: 'Glano',
			contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email },
		},
	},
];
---

<Layout
	title="Support — Glano"
	description="Get help with Glano. Contact us at support@glano.co for app support, technical issues, billing questions or anything else."
	jsonLd={jsonLd}
>
	<Nav />
	<main id="main" class="support">
		<div class="container support__inner">
			<header class="support__head">
				<p class="label">Support</p>
				<h1 class="h2">How can we help?</h1>
				<p class="lead">
					Questions about using Glano, a technical issue, billing, or anything else? Send us an email and we'll get back
					to you.
				</p>
			</header>

			<section class="contact" aria-labelledby="contact-title">
				<h2 class="contact__label" id="contact-title">Email us</h2>
				<a class="contact__email" href={`mailto:${email}`}>{email}</a>
				<a class="btn contact__btn" href={`mailto:${email}`}>
					<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
						<rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
						<path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
					Email support
				</a>
			</section>

			<ul class="notes" role="list">
				<li>
					<h2 class="notes__title">Help us help you</h2>
					<p>
						Include your iPhone model, iOS version and a short description of the issue. Please don't send sensitive
						personal or payment information.
					</p>
				</li>
				<li>
					<h2 class="notes__title">Purchases and refunds</h2>
					<p>
						Subscriptions and payments are handled by Apple. You can manage or cancel them in your Apple Account
						settings, and request refunds through Apple.
					</p>
				</li>
			</ul>
		</div>
	</main>
	<Footer showCta={false} />
</Layout>

<style>
	.support {
		padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem) clamp(4.5rem, 3rem + 5vw, 7.5rem);
	}

	.support__inner {
		display: grid;
		gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
		max-width: calc(46rem + var(--gutter) * 2);
	}

	.support__head {
		display: grid;
		gap: 1rem;
	}

	.support__head .lead {
		max-width: 34rem;
	}

	/* Prominent contact block */
	.contact {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
		border-radius: var(--radius);
		background: #f5f4f0;
		box-shadow: inset 0 0 0 1px rgba(20, 18, 27, 0.04);
	}

	.contact__label {
		font-family: var(--font-ui);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-3);
	}

	.contact__email {
		font-family: var(--font-head);
		font-weight: 500;
		font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--ink);
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
		transition: text-decoration-color 0.2s ease;
	}

	.contact__email:hover {
		text-decoration-color: var(--ink);
	}

	.contact__btn {
		margin-top: 0.75rem;
		height: 3rem;
		padding-inline: 1.4rem;
	}

	/* Short practical notes */
	.notes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
		margin: 0;
	}

	.notes li {
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.notes__title {
		font-family: var(--font-head);
		font-weight: 500;
		font-size: 1.125rem;
		letter-spacing: -0.01em;
	}

	.notes p {
		margin-top: 0.4rem;
		font-size: 0.9375rem;
		color: var(--ink-2);
	}

	@media (max-width: 640px) {
		.notes {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
