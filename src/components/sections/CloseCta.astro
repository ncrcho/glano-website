---
/**
 * Closing download section — the headline and App Store button beside a
 * square collage of everyday photos and videos (the moments worth keeping).
 * Photos: Unsplash (Unsplash License), via picsum.photos — Margaret Barley
 * (Santorini), Carli Jean (latte), Marat Gilyadzinov (jellyfish), veeterzy
 * (strawberries). Videos: Mixkit (Mixkit Free License) — clips 1013 (beach
 * walk), 1552 (dog) and 4064 (fireworks), cut to 10-second loops.
 */
import { Image } from 'astro:assets';
import AppStoreButton from '../ui/AppStoreButton.astro';
import santorini from '../../assets/close/photo-49.jpg';
import latte from '../../assets/close/photo-431.jpg';
import jellyfish from '../../assets/close/photo-1069.jpg';
import strawberries from '../../assets/close/photo-1080.jpg';
---

<section class="close close--collage" id="download" aria-labelledby="close-title" data-close>
	<div class="container collage-wrap">
		<div class="collage-text">
			<h2 class="display close__title" id="close-title">Get your storage back.</h2>
			<AppStoreButton />
		</div>
		<div class="collage" aria-hidden="true">
			<figure class="tile c-tall">
				<video muted loop playsinline preload="none" poster="/videos/beach-walk.jpg" data-src="/videos/beach-walk.mp4" />
				<span class="tile__badge">
					<svg viewBox="0 0 24 24" width="10" height="10">
						<path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
					</svg>
					0:10
				</span>
			</figure>
			<figure class="tile c-a"><Image src={santorini} alt="" widths={[240, 480]} sizes="240px" /></figure>
			<figure class="tile c-b"><Image src={latte} alt="" widths={[240, 480]} sizes="240px" /></figure>
			<figure class="tile c-wide">
				<video muted loop playsinline preload="none" poster="/videos/dog-wide.jpg" data-src="/videos/dog-wide.mp4" />
				<span class="tile__badge">
					<svg viewBox="0 0 24 24" width="10" height="10">
						<path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
					</svg>
					0:10
				</span>
			</figure>
			<figure class="tile c-c"><Image src={jellyfish} alt="" widths={[240, 480]} sizes="240px" /></figure>
			<figure class="tile c-d">
				<video muted loop playsinline preload="none" poster="/videos/fireworks.jpg" data-src="/videos/fireworks.mp4" />
				<span class="tile__badge">
					<svg viewBox="0 0 24 24" width="10" height="10">
						<path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
					</svg>
					0:10
				</span>
			</figure>
			<figure class="tile c-e"><Image src={strawberries} alt="" widths={[240, 480]} sizes="240px" /></figure>
		</div>
	</div>
</section>

<style>
	.close {
		padding-block: clamp(4rem, 3rem + 4vw, 7rem) clamp(4.5rem, 3rem + 5vw, 7.5rem);
		border-top: 1px solid var(--line);
		overflow: clip;
	}

	/* Headline on the left, square collage on the right. */
	.collage-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 6rem);
	}

	.collage-text {
		display: grid;
		justify-items: start;
		gap: 2.25rem;
	}

	.close__title {
		max-width: 10ch;
	}

	/* 3 × 3 grid: tall video on the left, wide video in the middle row. */
	.collage {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: clamp(8px, 1vw, 14px);
		aspect-ratio: 1 / 1;
		width: 100%;
		max-width: 560px;
		justify-self: end;
	}

	.c-tall { grid-column: 1; grid-row: 1 / span 2; }
	.c-a { grid-column: 2; grid-row: 1; }
	.c-b { grid-column: 3; grid-row: 1; }
	.c-wide { grid-column: 2 / span 2; grid-row: 2; }
	.c-c { grid-column: 1; grid-row: 3; }
	.c-d { grid-column: 2; grid-row: 3; }
	.c-e { grid-column: 3; grid-row: 3; }

	.tile {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: 18px;
		background: #ecebe6;
		box-shadow: 0 18px 40px -24px rgba(20, 18, 27, 0.45);
	}

	.tile :global(img),
	.tile video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tile__badge {
		position: absolute;
		left: 10px;
		bottom: 10px;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 8px;
		border-radius: 999px;
		background: rgba(20, 18, 27, 0.55);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: #fff;
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 1023px) {
		.tile {
			border-radius: 14px;
		}
	}

	/* Mobile: headline on top, collage full width below. */
	@media (max-width: 759px) {
		.collage-wrap {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.75rem;
		}

		.collage-text {
			justify-items: center;
			text-align: center;
		}

		.close__title {
			max-width: 11ch;
		}

		.collage {
			max-width: none;
			justify-self: stretch;
		}

		.tile {
			border-radius: 12px;
		}

		.tile__badge {
			left: 6px;
			bottom: 6px;
			padding: 2px 6px;
			font-size: 0.6875rem;
		}
	}
</style>

<script>
	// Videos load and play only while the section is on screen (muted, looped).
	const section = document.querySelector<HTMLElement>('[data-close]');
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (section && !reduce) {
		const videos = Array.from(section.querySelectorAll<HTMLVideoElement>('video'));
		new IntersectionObserver(
			([entry]) => {
				videos.forEach((v) => {
					if (entry.isIntersecting && v.getClientRects().length) {
						if (!v.getAttribute('src')) v.src = v.dataset.src!;
						v.play().catch(() => {});
					} else {
						v.pause();
					}
				});
			},
			{ threshold: 0.2 },
		).observe(section);
	}
</script>
