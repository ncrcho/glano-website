---
/**
 * The Stage — "How it works", told through scrolling.
 * Desktop/tablet: a sticky phone beside four tall step sections; the screen
 * follows the step in view. Mobile: each step is its own block with its own
 * phone, in a natural vertical flow (no sticky phone covering the text).
 */
import PhoneFrame from '../ui/PhoneFrame.astro';
import HomeScreen from '../screens/HomeScreen.astro';
import SwipeDemo from '../screens/SwipeDemo.astro';
import VideoScreen from '../screens/VideoScreen.astro';
import ReviewScreen from '../screens/ReviewScreen.astro';

const chapters = [
	{ id: 'find', n: '01', name: 'Find' },
	{ id: 'decide', n: '02', name: 'Decide' },
	{ id: 'inspect', n: '03', name: 'Inspect' },
	{ id: 'review', n: '04', name: 'Review' },
];

const categories = [
	{ key: 'duplicates', name: 'Duplicates', note: 'Exact copies, matched instantly' },
	{ key: 'screenshots', name: 'Screenshots', note: 'Receipts, memes, old tickets' },
	{ key: 'similar', name: 'Similar photos', note: 'Bursts and near-identical shots' },
	{ key: 'videos', name: 'Large videos', note: 'The biggest files, biggest first' },
];
---

<section class="stage stage--half" id="how" aria-labelledby="stage-title" data-stage>
	<div class="container">
		<header class="stage__head">
			<div class="stage__intro">
				<p class="label">How it works</p>
				<h2 class="h2" id="stage-title">See it work. Right here.</h2>
			</div>
			<p class="lead">This is the Glano experience. Scroll through it, and try it as you go.</p>
		</header>

		<div class="stage__body">
			<!-- Desktop / tablet: one sticky phone whose screen follows the step in view -->
			<div class="device" data-device>
				<div class="device__inner">
					<div class="device__glow" aria-hidden="true"></div>
					<PhoneFrame label="Interactive Glano demo">
						<div class="screens">
							<div class="screen is-active" data-screen="find"><HomeScreen counts /></div>
							<div class="screen" data-screen="decide"><SwipeDemo /></div>
							<div class="screen" data-screen="inspect"><VideoScreen /></div>
							<div class="screen" data-screen="review"><ReviewScreen /></div>
						</div>
					</PhoneFrame>
					<div class="progress" aria-hidden="true">
						{chapters.map((c, i) => <span class:list={['progress__seg', { 'is-active': i === 0 }]} data-progress={c.id} />)}
					</div>
				</div>
			</div>

			<div class="chapters">
				<article class="chapter is-active" id="ch-find" data-chapter="find">
					<div class="chapter__text">
						<p class="chapter__n mono">01 · Find</p>
						<h3 class="chapter__title">Find what's taking space.</h3>
						<p class="chapter__body">
							Glano scans your library on your iPhone and sorts the clutter into four groups, with counts and sizes, so
							you know exactly where your storage went.
						</p>
						<ul class="cats" role="list">
							{
								categories.map((c) => (
									<li>
										<button type="button" class="cat" data-cat-btn={c.key}>
											<span class="cat__name">{c.name}</span>
											<span class="cat__note">{c.note}</span>
										</button>
									</li>
								))
							}
						</ul>
					</div>
					<div class="chapter__visual">
						<PhoneFrame label="Glano home screen with storage found by category"><HomeScreen counts /></PhoneFrame>
					</div>
				</article>

				<article class="chapter" id="ch-decide" data-chapter="decide">
					<div class="chapter__text">
						<p class="chapter__n mono">02 · Decide</p>
						<h3 class="chapter__title">One photo at a time. Your call.</h3>
						<p class="chapter__body">
							Swipe left to clear, right to keep. Every photo shows its file details, and Undo brings back the last one
							in a tap.
						</p>
						<p class="hint mono">↔ Drag the photo left or right</p>
					</div>
					<div class="chapter__visual">
						<PhoneFrame label="Interactive photo review: swipe to keep or clear"><SwipeDemo /></PhoneFrame>
					</div>
				</article>

				<article class="chapter" id="ch-inspect" data-chapter="inspect">
					<div class="chapter__text">
						<p class="chapter__n mono">03 · Inspect</p>
						<h3 class="chapter__title">Biggest videos first.</h3>
						<p class="chapter__body">
							Glano sorts your large videos from biggest to smallest. Preview each one, scrub through it, then swipe to
							keep or clear.
						</p>
						<p class="hint mono">↔ Drag the timeline, then swipe the card</p>
					</div>
					<div class="chapter__visual">
						<PhoneFrame label="Interactive video review, largest videos first"><VideoScreen /></PhoneFrame>
					</div>
				</article>

				<article class="chapter" id="ch-review" data-chapter="review">
					<div class="chapter__text">
						<p class="chapter__n mono">04 · Review</p>
						<h3 class="chapter__title">Nothing disappears by accident.</h3>
						<p class="chapter__body">
							Everything you clear is sorted into its category in Cleaned Items, with counts and sizes, so you can review
							it before it's deleted for good.
						</p>
					</div>
					<div class="chapter__visual">
						<PhoneFrame label="Cleaned Items, organized by category"><ReviewScreen /></PhoneFrame>
					</div>
				</article>
			</div>
		</div>
	</div>
</section>

<style>
	.stage {
		/* Phone width: fits the viewport height so the sticky phone is fully visible. */
		--P: clamp(240px, calc((100svh - 190px) * 0.46), 310px);
		--top: max(84px, calc(50svh - var(--P) * 1.087 + 10px));
		padding-block: var(--section);
		border-top: 1px solid var(--line);
		overflow-x: clip;
	}

	/* --- Header -------------------------------------------------------------- */
	.stage__head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
		gap: 1.25rem clamp(2rem, 5vw, 5rem);
	}

	.stage__intro {
		display: grid;
		gap: 1rem;
	}

	.stage__head .lead {
		max-width: 26rem;
	}

	/* --- Desktop / tablet: sticky phone + scrolling steps --------------------- */
	.stage__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		margin-top: clamp(1rem, 2vw, 2rem);
	}

	.device {
		position: relative;
		z-index: 1;
	}

	.device__inner {
		position: sticky;
		top: var(--top);
		display: grid;
		justify-items: center;
		gap: 1.5rem;
	}

	.device :global(.phone) {
		--w: var(--P);
		position: relative;
	}

	.device__glow {
		position: absolute;
		inset: -6% -8% 2rem;
		background: radial-gradient(closest-side, rgba(20, 18, 27, 0.06), transparent);
		z-index: -1;
		pointer-events: none;
	}

	.progress {
		display: flex;
		gap: 6px;
	}

	.progress__seg {
		width: 22px;
		height: 3px;
		border-radius: 3px;
		background: var(--line);
		transition:
			background-color 0.4s ease,
			width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.progress__seg.is-active {
		width: 34px;
		background: var(--ink);
	}

	.screens {
		position: absolute;
		inset: 0;
	}

	.screen {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px);
		pointer-events: none;
		transition:
			opacity 0.35s ease,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 0.45s;
	}

	/* Nested views may set visibility: visible, so hide them from input too. */
	.screen:not(.is-active) :global(*) {
		visibility: hidden !important;
	}

	.screen.is-active {
		pointer-events: auto;
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 0.35s ease 0.05s,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.05s,
			visibility 0s;
	}

	/* Each step gets its own tall scroll section; the active one is in full ink. */
	.chapter {
		display: flex;
		align-items: center;
		min-height: max(78svh, calc(var(--P) * 2.174 + 4rem));
		opacity: 0.28;
		transition: opacity 0.5s ease;
	}

	.chapter.is-active {
		opacity: 1;
	}

	.chapter__text {
		max-width: 28rem;
		transform: translateY(12px);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.chapter.is-active .chapter__text {
		transform: none;
	}

	.chapter__visual {
		display: none;
	}

	.chapter__n {
		font-size: 0.8125rem;
		color: var(--ink-3);
	}

	.chapter__title {
		margin-top: 0.85rem;
		font-family: var(--font-head);
		font-weight: 500;
		font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.chapter__body {
		margin-top: 1rem;
		color: var(--ink-2);
		text-wrap: pretty;
	}

	.hint {
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		color: var(--ink-3);
	}

	.cats {
		display: grid;
		width: 100%;
		margin-top: 1.75rem;
		border-top: 1px solid var(--line);
	}

	.cat {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		width: 100%;
		padding: 0.85rem 0;
		border: 0;
		border-bottom: 1px solid var(--line);
		background: none;
		font: inherit;
		color: var(--ink);
		text-align: left;
		cursor: default;
		transition: padding 0.3s ease;
	}

	.cat:hover,
	.cat:focus-visible,
	.cat.is-hi {
		padding-left: 0.5rem;
	}

	.cat__name {
		font-family: var(--font-head);
		font-weight: 500;
		font-size: 1.0625rem;
	}

	.cat__note {
		font-size: 0.875rem;
		color: var(--ink-3);
	}

	/* --- Variation "half": phone on a half-bleed surface, steps on the right -- */
	@media (min-width: 1024px) {
		.stage--half .stage__body {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: clamp(3rem, 7vw, 7rem);
			margin-top: clamp(2.5rem, 4vw, 4rem);
		}

		/* The surface runs from the screen's left edge to just past the phone
		   column, and down to the end of the section. */
		.stage--half .device::before {
			content: '';
			position: absolute;
			top: 0;
			/* Stops short of the section's end, leaving a clear gap before the
			   next (dark) section. */
			bottom: calc(var(--section) * -0.4);
			left: -100vw;
			right: clamp(-3.5rem, -3.5vw, -1.5rem);
			border-radius: 0 32px 32px 0;
			background: #f5f4f0;
			z-index: -1;
		}

		.stage--half .device__glow {
			display: none;
		}

		.stage--half .device__inner {
			padding-block: 1.5rem;
		}

		.stage--half .chapter__text {
			padding-left: clamp(0rem, 1vw, 1rem);
		}
	}

	/* --- Tablet --------------------------------------------------------------- */
	@media (max-width: 1023px) {
		.stage {
			--P: clamp(230px, calc((100svh - 190px) * 0.46), 260px);
		}

		.stage__body {
			gap: 2.5rem;
		}

		.cat__note {
			display: none;
		}
	}

	/* --- Mobile: one block per step, each with its own phone ------------------ */
	@media (max-width: 759px) {
		.stage {
			--P: min(250px, 66vw);
		}

		.stage__head {
			grid-template-columns: minmax(0, 1fr);
		}

		.stage__body {
			display: block;
			margin-top: 0;
		}

		.device {
			display: none;
		}

		.chapter {
			display: grid;
			gap: 2rem;
			min-height: 0;
			padding-top: 3.5rem;
			opacity: 1;
		}

		.chapter + .chapter {
			margin-top: 1.5rem;
			border-top: 1px solid var(--line);
		}

		.chapter__text {
			max-width: none;
			transform: none;
		}

		.chapter__visual {
			position: relative;
			display: flex;
			justify-content: center;
		}

		.chapter__visual::before {
			content: '';
			position: absolute;
			inset: -4% 0;
			background: radial-gradient(closest-side, rgba(20, 18, 27, 0.05), transparent);
			z-index: -1;
			pointer-events: none;
		}

		.chapter__visual :global(.phone) {
			--w: var(--P);
		}

		.chapter__title {
			font-size: 1.75rem;
		}
	}
</style>

<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const mobile = matchMedia('(max-width: 759px)');
	const stage = document.querySelector<HTMLElement>('[data-stage]')!;
	const chapters = Array.from(stage.querySelectorAll<HTMLElement>('[data-chapter]'));
	const screens = Array.from(stage.querySelectorAll<HTMLElement>('.device [data-screen]'));
	const progress = Array.from(stage.querySelectorAll<HTMLElement>('[data-progress]'));
	// An element is "shown" when no ancestor is display:none (desktop vs mobile phones).
	const shown = (el: HTMLElement) => el.getClientRects().length > 0;

	/* ---------- Scroll-based step detection ---------- */
	let active = 'find';
	let inView = false;
	const setActive = (id: string) => {
		if (id === active) return;
		active = id;
		screens.forEach((s) => s.classList.toggle('is-active', s.dataset.screen === id));
		chapters.forEach((c) => c.classList.toggle('is-active', c.dataset.chapter === id));
		progress.forEach((p) => p.classList.toggle('is-active', p.dataset.progress === id));
		stage.dispatchEvent(new CustomEvent('chapter', { detail: id }));
	};

	let ticking = false;
	const detect = () => {
		ticking = false;
		const vh = innerHeight;
		const s = stage.getBoundingClientRect();
		const visible = s.top < vh * 0.75 && s.bottom > vh * 0.25;
		if (visible !== inView) {
			inView = visible;
			stage.dispatchEvent(new CustomEvent('visibility', { detail: inView }));
		}
		// A step becomes active once its section crosses the activation line.
		const line = vh * (mobile.matches ? 0.6 : 0.5);
		let current = chapters[0].dataset.chapter!;
		for (const c of chapters) if (c.getBoundingClientRect().top < line) current = c.dataset.chapter!;
		setActive(current);
	};
	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(detect);
	};
	addEventListener('scroll', onScroll, { passive: true });
	addEventListener('resize', onScroll);
	mobile.addEventListener('change', () => {
		stage.querySelectorAll('video').forEach((v) => v.pause());
		onScroll();
	});
	detect();

	/* ---------- 01 Find: category highlight ---------- */
	const rows = Array.from(stage.querySelectorAll<HTMLElement>('[data-cat]'));
	const catBtns = Array.from(stage.querySelectorAll<HTMLElement>('[data-cat-btn]'));
	const highlight = (key: string | null) => {
		rows.forEach((r) => r.classList.toggle('is-hi', r.dataset.cat === key));
		catBtns.forEach((b) => b.classList.toggle('is-hi', b.dataset.catBtn === key));
	};
	let hovering = false;
	catBtns.forEach((b) => {
		const on = () => {
			hovering = true;
			highlight(b.dataset.catBtn!);
		};
		const off = () => {
			hovering = false;
			highlight(null);
		};
		b.addEventListener('mouseenter', on);
		b.addEventListener('focus', on);
		b.addEventListener('mouseleave', off);
		b.addEventListener('blur', off);
	});
	// Gentle auto-cycle while the step is active and nobody is hovering.
	let cycle = 0;
	setInterval(() => {
		if (reduce || hovering || !inView || active !== 'find') return;
		highlight(catBtns[cycle % catBtns.length].dataset.catBtn!);
		cycle++;
	}, 1800);

	/* ---------- Shared review deck (02 Decide photos, 03 Inspect videos) ---------- */
	type Deck = {
		root: HTMLElement;
		cards: HTMLElement[];
		top: () => HTMLElement | undefined;
		decide: (dir: -1 | 1) => void;
		nudge: () => void;
		onTop: (fn: (card: HTMLElement | undefined) => void) => void;
	};

	function createDeck(root: HTMLElement): Deck {
		const deck = root.querySelector<HTMLElement>('[data-deck]')!;
		const cards = Array.from(deck.querySelectorAll<HTMLElement>('[data-card]'));
		const undoBtn = root.querySelector<HTMLButtonElement>('[data-undo]')!;
		const countEl = root.querySelector<HTMLElement>('[data-count-now]')!;
		const start = Number(root.dataset.start || 1);
		const history: number[] = [];
		const listeners: ((card: HTMLElement | undefined) => void)[] = [];
		let index = 0;
		let resetTimer = 0;
		let hintTimers: number[] = [];

		const layout = () => {
			cards.forEach((c, i) => {
				const pos = i - index;
				c.classList.toggle('is-top', pos === 0);
				c.classList.toggle('is-behind', pos > 1);
				if (pos >= 0) c.classList.remove('is-gone');
			});
			countEl.textContent = String(start + Math.min(index, cards.length - 1));
			undoBtn.disabled = history.length === 0;
			listeners.forEach((fn) => fn(cards[index]));
		};

		const drag = (card: HTMLElement, dx: number, dy = 0) => {
			const r = Math.max(-1, Math.min(1, dx / (deck.clientWidth * 0.5)));
			card.style.setProperty('--dx', `${dx}px`);
			card.style.setProperty('--dy', `${dy}px`);
			card.style.setProperty('--rot', `${r * 10}deg`);
			card.style.setProperty('--sl', String(Math.max(0, -r * 1.6)));
			card.style.setProperty('--sr', String(Math.max(0, r * 1.6)));
		};

		const cancelNudge = () => {
			if (!hintTimers.length) return;
			hintTimers.forEach(clearTimeout);
			hintTimers = [];
			const card = cards[index];
			if (card) {
				card.style.transition = '';
				drag(card, 0);
			}
		};

		const decide = (dir: -1 | 1) => {
			const card = cards[index];
			if (!card) return;
			cancelNudge();
			card.classList.remove('is-drag');
			drag(card, dir * deck.clientWidth * 1.5, -40);
			card.classList.add('is-gone');
			history.push(index);
			index++;
			layout();
			if (index >= cards.length)
				resetTimer = window.setTimeout(() => {
					index = 0;
					history.length = 0;
					cards.forEach((c) => drag(c, 0));
					layout();
				}, 1200);
		};

		undoBtn.addEventListener('click', () => {
			const last = history.pop();
			if (last === undefined) return;
			clearTimeout(resetTimer);
			index = last;
			cards[index].classList.remove('is-gone');
			drag(cards[index], 0);
			layout();
		});

		// Drag to swipe. Controls inside the card (play, timeline) are excluded.
		let startX = 0;
		let startY = 0;
		let dragging: HTMLElement | null = null;
		deck.addEventListener('pointerdown', (e) => {
			const target = e.target as HTMLElement;
			if (target.closest('[data-track], [data-play]')) return;
			const card = target.closest<HTMLElement>('[data-card]');
			if (!card?.classList.contains('is-top')) return;
			cancelNudge();
			dragging = card;
			startX = e.clientX;
			startY = e.clientY;
			card.classList.add('is-drag');
			card.setPointerCapture(e.pointerId);
		});
		deck.addEventListener('pointermove', (e) => {
			if (dragging) drag(dragging, e.clientX - startX, (e.clientY - startY) * 0.2);
		});
		const endDrag = (e: PointerEvent) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			const card = dragging;
			dragging = null;
			card.classList.remove('is-drag');
			if (Math.abs(dx) > deck.clientWidth * 0.25) decide(dx < 0 ? -1 : 1);
			else drag(card, 0);
		};
		deck.addEventListener('pointerup', endDrag);
		deck.addEventListener('pointercancel', endDrag);

		// One-time teaching nudge: left (clear), right (keep), back to rest.
		const nudge = () => {
			const card = cards[index];
			if (!card || reduce) return;
			const d = deck.clientWidth * 0.16;
			card.style.transition = 'transform 0.65s cubic-bezier(0.45, 0, 0.25, 1)';
			[
				[450, -d],
				[1150, d],
				[1850, 0],
			].forEach(([at, dx]) => hintTimers.push(window.setTimeout(() => drag(card, dx), at)));
			hintTimers.push(
				window.setTimeout(() => {
					card.style.transition = '';
					hintTimers = [];
				}, 2550),
			);
		};

		layout();
		return {
			root,
			cards,
			top: () => cards[index],
			decide,
			nudge,
			onTop: (fn) => {
				listeners.push(fn);
				fn(cards[index]);
			},
		};
	}

	// Every phone instance (desktop sticky phone + mobile per-step phones) is
	// interactive; actions always target the instance that is currently shown.
	const decks = Array.from(stage.querySelectorAll<HTMLElement>('[data-review-deck]')).map((root) => ({
		kind: root.dataset.reviewDeck as 'photo' | 'video',
		deck: createDeck(root),
	}));
	const shownDeck = (kind: 'photo' | 'video') => decks.find((d) => d.kind === kind && shown(d.deck.root))?.deck;
	const videoDecks = decks.filter((d) => d.kind === 'video').map((d) => d.deck);

	addEventListener('keydown', (e) => {
		if (!inView || (e.target as HTMLElement).closest('input, textarea, [role="slider"]')) return;
		const d = active === 'decide' ? shownDeck('photo') : active === 'inspect' ? shownDeck('video') : undefined;
		if (!d) return;
		if (e.key === 'ArrowLeft') d.decide(-1);
		if (e.key === 'ArrowRight') d.decide(1);
	});

	/* ---------- 03 Inspect: video playback inside the top card ---------- */
	const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
	const videoOf = (card?: HTMLElement) => card?.querySelector<HTMLVideoElement>('video') ?? null;
	const durOf = (v: HTMLVideoElement) => (Number.isFinite(v.duration) && v.duration > 0 ? v.duration : 1);
	const pauseAll = () => stage.querySelectorAll('video').forEach((v) => v.pause());
	const paint = (card: HTMLElement, p: number) => {
		p = Math.min(1, Math.max(0, p));
		card.style.setProperty('--p', p.toFixed(4));
		const v = videoOf(card)!;
		card.querySelector<HTMLElement>('[data-time]')!.textContent = fmt(p * durOf(v));
		card.querySelector<HTMLElement>('[data-track]')!.setAttribute('aria-valuenow', String(Math.round(p * 100)));
	};
	const ensureSrc = (v: HTMLVideoElement) => {
		if (!v.getAttribute('src')) {
			v.src = v.dataset.src!;
			v.preload = 'auto';
		}
	};
	const playTop = () => {
		const v = videoOf(shownDeck('video')?.top());
		if (!v || reduce) return;
		pauseAll();
		ensureSrc(v);
		v.play().catch(() => {});
	};

	let scrubbing = false;
	let videoHinted = false;
	let hintRaf = 0;
	type SeekCard = HTMLElement & { seek?: (p: number) => void };

	videoDecks.forEach((vdeck) => {
		vdeck.cards.forEach((card) => {
			const v = videoOf(card)!;
			let raf = 0;
			const frame = () => {
				if (!scrubbing) paint(card, v.currentTime / durOf(v));
				if (!v.paused) raf = requestAnimationFrame(frame);
			};
			v.addEventListener('play', () => {
				card.classList.add('is-playing');
				cancelAnimationFrame(raf);
				raf = requestAnimationFrame(frame);
			});
			v.addEventListener('pause', () => card.classList.remove('is-playing'));
			v.addEventListener('seeked', () => !scrubbing && paint(card, v.currentTime / durOf(v)));
			card.querySelector('[data-play]')!.addEventListener('click', () => {
				ensureSrc(v);
				if (v.paused) v.play().catch(() => {});
				else v.pause();
			});

			const track = card.querySelector<HTMLElement>('[data-track]')!;
			let wasPlaying = false;
			const seek = (p: number) => {
				p = Math.min(1, Math.max(0, p));
				paint(card, p);
				const t = p * durOf(v);
				if (scrubbing && 'fastSeek' in v) v.fastSeek(t);
				else v.currentTime = t;
			};
			const fromPointer = (e: PointerEvent) => {
				const r = track.getBoundingClientRect();
				seek((e.clientX - r.left) / r.width);
			};
			track.addEventListener('pointerdown', (e) => {
				cancelVideoHint();
				ensureSrc(v);
				scrubbing = true;
				wasPlaying = !v.paused;
				v.pause();
				track.setPointerCapture(e.pointerId);
				fromPointer(e);
			});
			track.addEventListener('pointermove', (e) => scrubbing && fromPointer(e));
			const end = () => {
				if (!scrubbing) return;
				scrubbing = false;
				v.currentTime = (Number(card.style.getPropertyValue('--p')) || 0) * durOf(v);
				if (wasPlaying) v.play().catch(() => {});
			};
			track.addEventListener('pointerup', end);
			track.addEventListener('pointercancel', end);
			track.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
				e.preventDefault();
				ensureSrc(v);
				seek((v.currentTime + (e.key === 'ArrowRight' ? 1 : -1)) / durOf(v));
			});
			(card as SeekCard).seek = seek;
		});

		// Only the top card plays; everything underneath stays paused.
		vdeck.onTop((top) => {
			vdeck.cards.forEach((c) => c !== top && videoOf(c)?.pause());
			if (top && inView && active === 'inspect' && videoHinted && shown(vdeck.root)) playTop();
		});
	});

	// One-time timeline demo on the first visit: sweep forward, ease back, play.
	function cancelVideoHint() {
		if (!hintRaf) return;
		cancelAnimationFrame(hintRaf);
		hintRaf = 0;
		stage.querySelectorAll('.is-hinting').forEach((c) => c.classList.remove('is-hinting'));
	}
	const playVideoHint = () => {
		videoHinted = true;
		const card = shownDeck('video')?.top() as SeekCard | undefined;
		const v = videoOf(card);
		if (!card || !v || !card.seek || reduce) return;
		const seek = card.seek;
		const run = () => {
			card.classList.add('is-hinting');
			const keys = [
				{ t: 0, p: 0 },
				{ t: 1100, p: 0.55 },
				{ t: 1900, p: 0.2 },
			];
			const t0 = performance.now();
			const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
			const step = (now: number) => {
				const el = now - t0;
				if (el >= keys[2].t) {
					hintRaf = 0;
					card.classList.remove('is-hinting');
					seek(keys[2].p);
					if (active === 'inspect' && inView) playTop();
					return;
				}
				const k = el < keys[1].t ? 0 : 1;
				const a = keys[k];
				const b = keys[k + 1];
				seek(a.p + (b.p - a.p) * ease((el - a.t) / (b.t - a.t)));
				hintRaf = requestAnimationFrame(step);
			};
			hintRaf = requestAnimationFrame(step);
		};
		ensureSrc(v);
		if (v.readyState >= 1) run();
		else v.addEventListener('loadedmetadata', run, { once: true });
	};

	// Start loading the first clip shortly before the section is reached.
	new IntersectionObserver(
		([entry], obs) => {
			if (!entry.isIntersecting) return;
			const v = videoOf(shownDeck('video')?.top());
			if (v) {
				ensureSrc(v);
				v.load();
			}
			obs.disconnect();
		},
		{ rootMargin: '100% 0px' },
	).observe(stage);

	/* ---------- Step changes ---------- */
	let photoHinted = false;
	const enter = (id: string) => {
		if (id === 'decide' && !photoHinted) {
			photoHinted = true;
			shownDeck('photo')?.nudge();
		}
		if (id === 'inspect') {
			if (!videoHinted) playVideoHint();
			else playTop();
		} else {
			cancelVideoHint();
			pauseAll();
		}
	};
	stage.addEventListener('chapter', ((e: CustomEvent) => inView && enter(e.detail)) as EventListener);
	// Pause when the section scrolls away; pick up the current step when it returns.
	stage.addEventListener('visibility', ((e: CustomEvent) => {
		if (e.detail) enter(active);
		else {
			cancelVideoHint();
			pauseAll();
		}
	}) as EventListener);

	// The page may load with the section already on screen (e.g. via /#how).
	if (inView) enter(active);
</script>
