---
import CloseCta from './CloseCta.astro';
import wordmark from '../../assets/app/wordmark.svg';
import { SITE } from '../../config';

interface Props {
	/** Show the closing download section above the footer (home page only). */
	showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
const links = [
	{ href: SITE.privacyUrl, label: 'Privacy Policy' },
	{ href: SITE.termsUrl, label: 'Terms of Use' },
	{ href: SITE.supportUrl, label: 'Support' },
];
---

{showCta && <CloseCta />}

<footer class="footer">
	<div class="container footer__inner">
		<img src={wordmark.src} alt="Glano" width="72" height="22" class="footer__logo" />
		<nav aria-label="Legal and support">
			<ul class="footer__links" role="list">
				{
					links.map((l) => (
						<li>
							<a href={l.href}>{l.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="footer__copy">© {year} Glano</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--line);
	}

	.footer__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		padding-block: 1.25rem;
	}

	.footer__logo {
		width: 72px;
		height: auto;
	}

	.footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 2rem;
		font-size: 0.875rem;
		color: var(--ink-2);
	}

	/* Comfortable tap targets (~44px) without changing the visual layout. */
	.footer__links a {
		display: inline-block;
		padding-block: 0.8125rem;
	}

	.footer__links a:hover {
		color: var(--ink);
	}

	.footer__copy {
		font-size: 0.875rem;
		color: var(--ink-3);
	}

	@media (max-width: 640px) {
		.footer__inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}

</style>
