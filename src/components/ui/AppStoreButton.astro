---
import { SITE } from '../../config';

interface Props {
	href?: string;
	class?: string;
}
const { href = SITE.appStoreUrl, class: className } = Astro.props;
---

<a href={href} class:list={['appstore', className]} aria-label="Download Glano on the App Store">
	<svg width="20" height="24" viewBox="0 0 17 20" aria-hidden="true" fill="currentColor">
		<path
			d="M14.04 10.63c-.02-2.3 1.88-3.41 1.97-3.46-1.07-1.57-2.74-1.78-3.33-1.8-1.42-.15-2.77.83-3.49.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.88 2.31 1.16-.05 1.59-.75 2.99-.75 1.4 0 1.79.75 3.01.72 1.24-.02 2.03-1.13 2.79-2.25.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.42-.93-2.45-3.71zM11.75 3.88c.64-.77 1.07-1.85.95-2.92-.92.04-2.03.61-2.69 1.38-.59.68-1.11 1.78-.97 2.83 1.03.08 2.07-.52 2.71-1.29z"
		></path>
	</svg>
	<span class="appstore__text">
		<span class="appstore__small">Download on the</span>
		<span class="appstore__big">App Store</span>
	</span>
</a>

<style>
	.appstore {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		height: 3.625rem;
		padding: 0 1.75rem 0 1.4rem;
		border-radius: 999px;
		background: var(--ink);
		color: #fff;
		font-family: var(--font-ui);
		transition: opacity 0.2s ease;
	}

	.appstore:hover {
		opacity: 0.85;
	}

	.appstore svg {
		margin-top: -2px;
	}

	.appstore__text {
		display: grid;
		line-height: 1.1;
	}

	.appstore__small {
		font-size: 0.6875rem;
		opacity: 0.75;
	}

	.appstore__big {
		font-weight: 600;
		font-size: 1.1875rem;
		letter-spacing: -0.01em;
	}
</style>
