---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Glano — Your camera roll, simplified',
	description = 'Glano finds duplicates, screenshots, similar photos and large videos, so you can free up iPhone storage in a few easy swipes. Everything stays on your iPhone.',
} = Astro.props;

// Clean canonical URL: "/privacy.html" -> "/privacy", "/index.html" -> "/".
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fffefb" />
		<meta name="color-scheme" content="light" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-display" preload />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 100;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--ink);
		color: #fff;
		font-size: 0.875rem;
		transform: translateY(-200%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: none;
	}
</style>
